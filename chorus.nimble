version     = "0.1.0"
author      = "daveey"
description = "Chorus: four cogs co-compose one piece of music on a 16-step sequencer for the Softmax Coworld platform. A deterministic public metric scores the piece; each seat's score is the counterfactual delta of its own voice."
license     = "MIT"

srcDir = "src"

requires "nim >= 2.2.4"
requires "bitworld >= 0.1.0"
requires "mummy >= 0.4.7"
requires "curly >= 1.1.1"
requires "whisky"
